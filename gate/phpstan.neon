includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Pre-existing findings in the theme, frozen at gate introduction. New
    # code must be clean; do not add to this file. netdust/ntdst-core and
    # netdust/ntdst-baseline are composer packages (their own repo, gate,
    # reviewers) and are excluded wholesale below — never baselined here.
    # Coupling: the baseline references the theme, which lives in THIS repo
    # (netdust/wp-starter) and is rendered into a project by
    # scaffold_wp_starter; regenerate with --generate-baseline after
    # changing the theme.
    - phpstan-baseline.neon

parameters:
    level: 6
    # Project-local cache — NEVER the shared system tmp. PHPStan's default
    # tmpDir (sys_get_temp_dir()/phpstan) is shared by every project on the
    # host: stale reflection entries pointing at another project's (since
    # deleted/moved) phpstan.phar poison a fresh site's FIRST `composer gate`
    # with "phar://…/phpstan.phar/….stub is not a file" internal errors
    # (hit on the T04 acceptance run via a stale gate-pilot cache).
    # Relative path → resolved beside this file, i.e. the project root.
    # The dir ships with the gate payload and self-ignores (.gitignore inside).
    # Coupling: run ALL phpstan invocations from ONE context (the host — the
    # gate is host-orchestrated); a container run would seed this shared,
    # mounted cache with container paths and recreate the same poisoning.
    tmpDir: .phpstan-cache
    scanFiles:
        # WP test-scaffold symbols (WP_UnitTestCase & friends) for the
        # integration tier under tests/Integration — discovery only, the
        # scaffold itself is never analysed. Deliberately NOT the whole
        # includes/ dir: its object-cache.php redeclares wp_cache_get with
        # a narrower signature than the WordPress stubs and would shadow it.
        - vendor/wp-phpunit/wp-phpunit/includes/phpunit-adapter-testcase.php
        - vendor/wp-phpunit/wp-phpunit/includes/abstract-testcase.php
        - vendor/wp-phpunit/wp-phpunit/includes/testcase.php
    paths:
        - {{GATE_CONTENT_DIR}}/mu-plugins
        - {{GATE_CONTENT_DIR}}/themes
        - tests
    excludePaths:
        # SPLIT ON PURPOSE — the framework packages sit under `analyse`, NOT
        # under the implicit `analyseAndScan` a bare `excludePaths:` gives you.
        #
        # analyseAndScan means PHPStan neither reports on the path NOR learns
        # the symbols in it. Right for licensed/third-party code nothing here
        # references; WRONG for the framework, because this payload's own tests
        # type against it — tests/Unit/ContainerTest.php uses NTDST_Container,
        # tests/Integration/DataLayerRoundTripTest.php calls ntdst_data(). Under
        # the flat form each of those becomes an "unknown class"/"unknown
        # function" (20 errors, measured on a real consumer), which a scaffolded
        # site can only silence by baselining them — and that same baseline
        # would swallow genuine typos.
        #
        # analyse = do not report on their code, but still know their symbols.
        analyse:
            # netdust/ntdst-core is a composer package with its own repo, gate,
            # and reviewers (github.com/netdust/ntdst-core) — only OUR code is
            # analysed here (ruling 2026-08-12, same posture as vendor/). The
            # `(?)` suffix makes a missing path non-fatal — harmless before the
            # first `composer update` installs it.
            - {{GATE_CONTENT_DIR}}/mu-plugins/ntdst-core/* (?)
            # netdust/ntdst-baseline is a composer package on the same terms.
            - {{GATE_CONTENT_DIR}}/mu-plugins/ntdst-baseline/* (?)
        analyseAndScan:
            # Composer-installed stock theme — not our code (constant name, portability-safe)
            - {{GATE_CONTENT_DIR}}/themes/twentytwentyfive (?)
            # roots/bedrock-disallow-indexing — composer-managed third-party
            # code, present in EVERY bedrock scaffold, and it carries a level-6
            # finding of its own (`Action callback returns 0 but should not
            # return anything`). Without this line a fresh site's very first
            # `composer gate` is red on someone else's code — or, worse, the
            # scaffold's `--generate-baseline` step freezes that finding into
            # the new project's baseline, where it looks like our debt forever.
            # phpcs.xml has excluded it since gate introduction; this makes the
            # two analysers agree.
            - {{GATE_CONTENT_DIR}}/mu-plugins/bedrock-disallow-indexing/* (?)
            # YOOtheme Pro parent — LICENSED VENDOR CODE, not ours (~41MB). Without
            # this, analysis walks the whole parent and reports 1000+ errors from
            # its own vendor packages (WooCommerce listeners, GD driver, ...), which
            # is a red gate on a freshly scaffolded YOOtheme site. Harmless on a
            # non-YOOtheme site: the path simply does not exist, and the `(?)`
            # suffix makes a missing path non-fatal.
            - {{GATE_CONTENT_DIR}}/themes/yootheme (?)
            # Theme build artifacts / JS dependencies — never analysed.
            # Trailing /* is required: wildcard excludePaths are fnmatch'd against
            # FILE paths, so a bare .../node_modules pattern never matches the files
            # beneath it (surfaced by flatted/php/flatted.php inside npm deps).
            - {{GATE_CONTENT_DIR}}/themes/*/node_modules/* (?)
            - {{GATE_CONTENT_DIR}}/themes/*/dist/* (?)
