<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheResultFile=".phpunit.cache/unit/test-results"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <!--
        UNIT tier of the package shape: the package's own tests/bootstrap.php, no WordPress,
        no database. The integration tier is phpunit.integration.xml. PHPUnit 10 runs this
        9-schema file and prints a deprecation for cacheResultFile.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
